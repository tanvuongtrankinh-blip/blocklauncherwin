<Window x:Class="BlockLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlockLauncher for Windows - ModPE script runner" Width="1000" Height="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Scripts" Margin="0,0,0,4" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="AddBtn" Content="Add..." Padding="10,3" Margin="0,0,6,0" Click="AddScript_Click" />
                <Button x:Name="ReloadBtn" Content="Reload" Padding="10,3" Margin="0,0,6,0" Click="ReloadScript_Click" />
                <Button x:Name="RemoveBtn" Content="Remove" Padding="10,3" Click="RemoveScript_Click" />
            </StackPanel>
            <ListBox x:Name="ScriptList" DisplayMemberPath="Name" SelectionChanged="ScriptList_SelectionChanged" />
        </DockPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Console" Margin="0,0,0,4" />
                <TextBox x:Name="Console" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock FontWeight="SemiBold" Text="Simulator (no real game attached)" Margin="0,0,0,4" />
                <WrapPanel>
                    <CheckBox x:Name="TickBox" Content="Run modTick (20/s)" VerticalAlignment="Center" Margin="0,0,12,0"
                              Checked="TickBox_Changed" Unchecked="TickBox_Changed" />
                    <Button Content="Use item at feet" Padding="10,3" Margin="0,0,6,0" Click="UseItem_Click" />
                    <Button Content="Spawn zombie" Padding="10,3" Margin="0,0,6,0" Click="Spawn_Click" />
                    <Button Content="Attack nearest" Padding="10,3" Margin="0,0,6,0" Click="Attack_Click" />
                    <Button Content="New level" Padding="10,3" Click="NewLevel_Click" />
                </WrapPanel>
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="Send" Padding="12,3" Margin="6,0,0,0" Click="Send_Click" IsDefault="True" />
                    <TextBox x:Name="Input" ToolTip="Chat text, or /command for procCmd" />
                </DockPanel>
                <TextBlock x:Name="Status" Margin="0,6,0,0" Foreground="Gray" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
